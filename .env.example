# -----------------------------------------------------------------------------
# SocialOps environment variables
# Copy to `.env` and fill in. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Postgres connection string (Neon in the MVP stack).
DATABASE_URL="postgresql://user:password@localhost:5432/socialops?schema=public"

# App-level encryption key for social tokens at rest.
# 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# --- Meta (Facebook + Instagram) Graph API ---
# Phase 1 targets Meta first. Values are read by the Meta adapter.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"

# --- Auth (Clerk, MVP stack) ---
# When BOTH are set, requests are authenticated via Clerk and the tenant is the
# Clerk Organization mapped to an Agency (Agency.clerkOrgId). When unset, the app
# falls back to trusting an `x-agency-id` request header (local dev / CI only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Shared secret for the scheduled-publish cron (/api/cron/publish-due).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# --- AI (Claude API) — used from Phase 4 onward ---
# ANTHROPIC_API_KEY=""

# --- Billing (Stripe, test mode) — used from Phase 5 onward ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
